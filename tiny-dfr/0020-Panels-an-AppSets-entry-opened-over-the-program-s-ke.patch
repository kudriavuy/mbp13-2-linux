     // one row per program key set, the F-key label rows, the lock row
-    let mut sets: Vec<_> = cfg.app_sets.values().chain(cfg.fn_rows.values()).copied().collect();
+    let mut sets: Vec<_> = cfg.app_sets.values().chain(cfg.fn_rows.values()).chain(cfg.panel_rows.iter()).copied().collect();
     sets.push(cfg.lock_row);
     sets.sort();
     for r in sets {
@@ -1736,6 +1736,8 @@ fn real_main(drm: &mut DrmBackend) {
         }
     };
     let mut active_layer = row(base_is_media, fn_held, expanded, collapsed_row, fn_row);
+    // a panel shown instead of the row (Command = "Open"); Fn still shows F-keys
+    let mut panel_row: Option<usize> = None;
     let mut slider: Option<Slider> = None;
     let mut slider_dirty = false;
     // the now-playing panel, and whether its capsule needs drawing
@@ -1853,6 +1855,7 @@ fn real_main(drm: &mut DrmBackend) {
             check_layer = true;
             media = None;
             emoji = None;
+            panel_row = None;
             fingerprint = touchid_icon(&cfg);
             bell = named_icon(cfg.notification_icon.as_ref());
             session = state_watch.read();
@@ -1888,6 +1891,7 @@ fn real_main(drm: &mut DrmBackend) {
                     layers[layer].buttons[btn].1.set_active(&mut uinput, false);
                 }
                 base_is_media = want_media;
+                panel_row = None;
                 collapsed_row = want_row;
                 fn_row = want_fn_row;
                 // each program starts with its own strip state
@@ -1976,6 +1980,8 @@ fn real_main(drm: &mut DrmBackend) {
                 needs_complete_redraw = true;
             }
             cfg.lock_row
+        } else if let (Some(p), false) = (panel_row, fn_held) {
+            p
         } else {
             row(base_is_media, fn_held, expanded, collapsed_row, fn_row)
         };
@@ -2690,11 +2696,27 @@ fn real_main(drm: &mut DrmBackend) {
                             }
                             // a command runs on release, while the finger is still on it
                             let command = button.command.filter(|_| button.active);
+                            // a panel's key did its work: the panel closes
+                            if button.active && command.is_none() && !button.action.is_empty() && cfg.panel_rows.contains(&layer) {
+                                panel_row = None;
+                            }
                             button.set_active(&mut uinput, false);
                             match command {
                                 Some(Command::Expand) => {
                                     expanded = true;
                                     strip_animate = true;
+                                    panel_row = None;
+                                }
+                                Some(Command::Open) => {
+                                    // a second tap closes it
+                                    let p = cfg.opens.get(&(layer, btn)).copied();
+                                    panel_row = if panel_row == p { None } else { p };
+                                    media = None;
+                                    emoji = None;
+                                    slider = None;
+                                }
+                                Some(Command::Close) => {
+                                    panel_row = None;
                                 }
                                 Some(Command::Collapse) => {
                                     expanded = false;
