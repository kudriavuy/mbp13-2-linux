@@ -39,6 +39,50 @@ pub struct Config {
     pub slider_fill_color: (f64, f64, f64),
     pub slider_track_color: (f64, f64, f64),
     pub animations: bool,
+    // key sets per program: rules in order, set name -> row
+    pub apps: Vec<AppRule>,
+    pub app_sets: HashMap<String, usize>,
+}
+
+/// [[Apps]]: windows whose class matches one of Match (case does not matter,
+/// a trailing * matches the start) get Set: "fn" (F1-F12), "strip" (the
+/// expanded Control Strip) or the name of an [AppSets] entry (its keys and the
+/// collapsed strip).
+#[derive(Deserialize, Clone)]
+#[serde(rename_all = "PascalCase")]
+pub struct AppRule {
+    pub r#match: Vec<String>,
+    pub set: String,
+}
+
+/// What a program gets on the bar
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum AppSet {
+    Fn,
+    Strip,
+    /// the collapsed strip with these keys: a row index
+    Keys(usize),
+}
+
+impl Config {
+    /// The set of the first rule matching window class `class`
+    pub fn set_for(&self, class: &str) -> Option<AppSet> {
+        let class = class.to_lowercase();
+        let rule = self.apps.iter().find(|r| {
+            r.r#match.iter().any(|p| {
+                let p = p.to_lowercase();
+                match p.strip_suffix('*') {
+                    Some(prefix) => class.starts_with(prefix),
+                    None => class == p,
+                }
+            })
+        })?;
+        match rule.set.as_str() {
+            "fn" => Some(AppSet::Fn),
+            "strip" => Some(AppSet::Strip),
+            name => self.app_sets.get(name).map(|&row| AppSet::Keys(row)),
+        }
+    }
 }
 
