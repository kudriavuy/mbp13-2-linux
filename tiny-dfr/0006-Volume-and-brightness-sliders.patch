+fn slider_kind(command: Option<Command>) -> Option<SliderKind> {
+    match command {
+        Some(Command::VolumeSlider) => Some(SliderKind::Volume),
+        Some(Command::BrightnessSlider) => Some(SliderKind::Brightness),
+        _ => None,
+    }
+}
+
+/// Pass the slider's value on: to the helper, or as keys without it
+fn apply_slider<F: AsRawFd>(s: &mut Slider, uinput: &mut UInputHandle<F>, force: bool) {
+    if s.send(force).is_err() {
+        let steps = s.fallback_steps();
+        let key = match (s.kind, steps > 0) {
+            (SliderKind::Volume, true) => Key::VolumeUp,
+            (SliderKind::Volume, false) => Key::VolumeDown,
+            (SliderKind::Brightness, true) => Key::BrightnessUp,
+            (SliderKind::Brightness, false) => Key::BrightnessDown,
+        };
+        for _ in 0..steps.abs() {
+            toggle_keys(uinput, &vec![key], 1);
+            toggle_keys(uinput, &vec![key], 0);
+        }
+    }
+}
