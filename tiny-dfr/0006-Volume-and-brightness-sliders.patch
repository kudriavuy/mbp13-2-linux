new file mode 100644
index 0000000..a95da29
--- /dev/null
+++ b/src/slider.rs
@@ -0,0 +1,254 @@
+// Volume and brightness sliders (macOS style). A tap on a slider button opens
+// the slider for SliderTimeout ms, where the value follows the finger on the
+// track; holding the button and sliding opens it until release, the value
+// moving with the finger from where it was. The slider covers the row right
+// of Esc: a close button, the button's icon, the track.
+//
+// The value goes to a helper in the desktop session (mbp-touchbar-bridge)
+// through the FIFO /run/tiny-dfr/bridge/cmd, which sets it the way the desktop
+// does (PulseAudio volume of the default sink, KDE screen brightness). Without
+// the helper tiny-dfr falls back to volume/brightness keys.
+use crate::{config::Config, Button};
+use cairo::Context;
+use std::{
+    fs::{self, OpenOptions},
+    io::Write,
+    os::unix::fs::OpenOptionsExt,
+    time::{Duration, Instant},
+};
+
+const BRIDGE_CMD: &str = "/run/tiny-dfr/bridge/cmd";
+const BRIDGE_VOLUME: &str = "/run/tiny-dfr/bridge/volume";
+// at most this often to the helper while the finger moves
+const SEND_INTERVAL: Duration = Duration::from_millis(30);
+// a hold turns into a slide after this many px sideways
+pub const DRAG_THRESHOLD_PX: f64 = 12.0;
+const CLOSE_WIDTH: f64 = 72.0;
+const ICON_WIDTH: f64 = 72.0;
+const TRACK_HEIGHT: f64 = 6.0;
+const KNOB_RADIUS: f64 = 13.0;
+// keys of the fallback: one per this much of the track
+const FALLBACK_STEP: f64 = 0.05;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Kind {
+    Volume,
+    Brightness,
+}
+
+impl Kind {
+    fn name(self) -> &'static str {
+        match self {
+            Kind::Volume => "volume",
+            Kind::Brightness => "brightness",
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Mode {
+    /// opened by a tap: closes at the deadline unless touched again
+    Tap { deadline: Instant },
+    /// opened by holding the button and sliding: closes on release
+    Drag { start_x: f64, start_value: f64 },
+}
+
+/// Where the parts are, in bar coordinates without pixel shift.
+pub struct Layout {
+    pub left: f64,
+    pub close: (f64, f64),
+    pub icon: (f64, f64),
+    pub track: (f64, f64),
+    pub right: f64,
+}
+
+pub enum Hit {
+    Close,
+    Track,
+}
+
+pub struct Slider {
+    pub kind: Kind,
+    pub value: f64,
+    pub mode: Mode,
+    // (row, button) that opened it: its icon is drawn on the slider
+    pub source: (usize, usize),
+    // the touch moving the knob
+    pub slot: Option<u32>,
+    sent_value: Option<f64>,
+    last_send: Option<Instant>,
+    // key fallback: the value the keys have reached so far
+    keys_value: f64,
+}
+
+impl Layout {
+    /// `left`: first px after Esc and its gap, `right`: end of the row
+    pub fn new(cfg: &Config, left: f64, right: f64) -> Layout {
+        let close = (left, CLOSE_WIDTH);
+        let icon = (close.0 + close.1 + cfg.button_spacing, ICON_WIDTH);
+        let track_left = icon.0 + icon.1 + cfg.button_spacing + KNOB_RADIUS;
+        let track_right = (right - KNOB_RADIUS - cfg.button_spacing).max(track_left + 1.0);
+        Layout {
+            left,
+            close,
+            icon,
+            track: (track_left, track_right),
+            right,
+        }
+    }
+    pub fn hit(&self, x: f64) -> Option<Hit> {
+        if x < self.left - 4.0 {
+            None
+        } else if x < self.close.0 + self.close.1 + 4.0 {
+            Some(Hit::Close)
+        } else {
+            Some(Hit::Track)
+        }
+    }
+    pub fn value_at(&self, x: f64) -> f64 {
+        ((x - self.track.0) / (self.track.1 - self.track.0)).clamp(0.0, 1.0)
+    }
+    pub fn track_len(&self) -> f64 {
+        self.track.1 - self.track.0
+    }
+}
+
+fn rounded_rect(c: &Context, x: f64, y: f64, w: f64, h: f64, r: f64) {
+    let r = r.min(h / 2.0).min(w / 2.0);
+    c.new_sub_path();
+    c.arc(x + w - r, y + r, r, (-90.0f64).to_radians(), 0.0);
+    c.arc(x + w - r, y + h - r, r, 0.0, (90.0f64).to_radians());
+    c.arc(x + r, y + h - r, r, (90.0f64).to_radians(), (180.0f64).to_radians());
+    c.arc(x + r, y + r, r, (180.0f64).to_radians(), (270.0f64).to_radians());
+    c.close_path();
+}
+
+/// Read the current value: volume from the helper's state file, brightness
+/// from the display backlight. None if unknown.
+pub fn current_value(kind: Kind) -> Option<f64> {
+    match kind {
+        Kind::Volume => {
+            let s = fs::read_to_string(BRIDGE_VOLUME).ok()?;
+            s.split_whitespace().next()?.parse::<f64>().ok().map(|v| v.clamp(0.0, 1.0))
+        }
+        Kind::Brightness => {
+            for name in ["intel_backlight", "acpi_video0", "gmux_backlight", "apple-panel-bl"] {
+                let dir = format!("/sys/class/backlight/{name}");
+                let read = |attr: &str| {
+                    fs::read_to_string(format!("{dir}/{attr}"))
+                        .ok()
+                        .and_then(|s| s.trim().parse::<f64>().ok())
+                };
+                if let (Some(now), Some(max)) = (read("actual_brightness"), read("max_brightness")) {
+                    if max > 0.0 {
+                        return Some((now / max).clamp(0.0, 1.0));
+                    }
+                }
+            }
+            None
+        }
+    }
+}
+
+impl Slider {
+    pub fn new(kind: Kind, mode: Mode, source: (usize, usize)) -> Slider {
+        let value = current_value(kind).unwrap_or(0.5);
+        Slider {
+            kind,
+            value,
+            mode,
+            source,
+            slot: None,
+            sent_value: Some(value),
+            last_send: None,
+            keys_value: value,
+        }
+    }
+
+    pub fn draw(&self, c: &Context, cfg: &Config, layout: &Layout, height: f64, shift: (f64, f64), icon: &Button) {
+        let (sx, sy) = shift;
+        let button_height = if cfg.button_height > 0.0 {
+            cfg.button_height.min(height)
+        } else {
+            height * 0.7
+        };
+        let top = (height - button_height) / 2.0;
+        // clear the whole slider area
+        c.set_source_rgb(0.0, 0.0, 0.0);
+        c.rectangle(layout.left + sx - 1.0, 0.0, layout.right - layout.left + 2.0, height);
+        c.fill().unwrap();
+        // close button with an x
+        let (r, g, b) = cfg.button_color;
+        c.set_source_rgb(r, g, b);
+        rounded_rect(c, layout.close.0 + sx, top, layout.close.1, button_height, cfg.button_radius);
+        c.fill().unwrap();
+        let (cx, cy, arm) = (layout.close.0 + layout.close.1 / 2.0 + sx, height / 2.0 + sy, 9.0);
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        c.set_line_width(2.5);
+        c.move_to(cx - arm, cy - arm);
+        c.line_to(cx + arm, cy + arm);
+        c.move_to(cx + arm, cy - arm);
+        c.line_to(cx - arm, cy + arm);
+        c.stroke().unwrap();
+        // the icon of the button that opened it
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        icon.render(c, height as i32, layout.icon.0 + sx, layout.icon.1 as u64, sy);
+        // capsule behind the track
+        let cap_left = layout.track.0 - KNOB_RADIUS - cfg.button_spacing / 2.0 + sx;
+        let cap_right = layout.track.1 + KNOB_RADIUS + cfg.button_spacing / 2.0 + sx;
+        c.set_source_rgb(r, g, b);
+        rounded_rect(c, cap_left, top, cap_right - cap_left, button_height, cfg.button_radius);
+        c.fill().unwrap();
+        // track: filled part white, the rest grey
+        let y = height / 2.0 - TRACK_HEIGHT / 2.0;
+        let knob_x = layout.track.0 + self.value * layout.track_len() + sx;
+        c.set_source_rgb(0.45, 0.45, 0.47);
+        rounded_rect(c, layout.track.0 + sx, y, layout.track_len(), TRACK_HEIGHT, TRACK_HEIGHT / 2.0);
+        c.fill().unwrap();
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        rounded_rect(c, layout.track.0 + sx, y, (knob_x - layout.track.0 - sx).max(TRACK_HEIGHT), TRACK_HEIGHT, TRACK_HEIGHT / 2.0);
+        c.fill().unwrap();
+        c.arc(knob_x, height / 2.0, KNOB_RADIUS, 0.0, std::f64::consts::TAU);
+        c.fill().unwrap();
+    }
+
+    /// Hand the value to the helper, at most every SEND_INTERVAL unless
+    /// `force`. Ok(true) sent or nothing to send, Ok(false) not yet (call
+    /// again), Err(()) no helper.
+    pub fn send(&mut self, force: bool) -> Result<bool, ()> {
+        if self.sent_value == Some(self.value) {
+            return Ok(true);
+        }
+        if !force && self.last_send.is_some_and(|t| t.elapsed() < SEND_INTERVAL) {
+            return Ok(false);
+        }
+        // non-blocking: no reader (helper not running) is ENXIO
+        let mut fifo = OpenOptions::new()
+            .write(true)
+            .custom_flags(libc::O_NONBLOCK)
+            .open(BRIDGE_CMD)
+            .map_err(|_| ())?;
+        fifo.write_all(format!("{} {:.4}\n", self.kind.name(), self.value).as_bytes())
+            .map_err(|_| ())?;
+        self.sent_value = Some(self.value);
+        self.last_send = Some(Instant::now());
+        Ok(true)
+    }
+
+    /// When the next send is due, if one is waiting
+    pub fn send_due_in(&self) -> Option<Duration> {
+        if self.sent_value == Some(self.value) {
+            return None;
+        }
+        Some(self.last_send.map_or(Duration::ZERO, |t| SEND_INTERVAL.saturating_sub(t.elapsed())))
+    }
+
+    /// Without the helper: how many key presses up (positive) or down make
+    /// the keys follow the value, in FALLBACK_STEP steps.
+    pub fn fallback_steps(&mut self) -> i32 {
+        let steps = ((self.value - self.keys_value) / FALLBACK_STEP).trunc() as i32;
+        self.keys_value += steps as f64 * FALLBACK_STEP;
+        self.sent_value = Some(self.value);
+        steps
+    }
+}
