+// "#rrggbb" -> (r, g, b) in 0..1; a bad value keeps the default
+fn parse_color(name: &str, value: Option<String>, default: (f64, f64, f64)) -> (f64, f64, f64) {
+    let Some(value) = value else { return default };
+    let hex = value.trim().trim_start_matches('#');
+    let channel = |i: usize| hex.get(i..i + 2).and_then(|c| u8::from_str_radix(c, 16).ok());
+    match (hex.len(), channel(0), channel(2), channel(4)) {
+        (6, Some(r), Some(g), Some(b)) => (r as f64 / 255.0, g as f64 / 255.0, b as f64 / 255.0),
+        _ => {
+            eprintln!("{name} = \"{value}\" is not #rrggbb; using the default");
+            default
+        }
+    }
 }
 
