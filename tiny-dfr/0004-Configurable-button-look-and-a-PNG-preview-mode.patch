+/// TINY_DFR_RENDER_PNG=<file>: draw the configured layers into a PNG instead
+/// of the Touch Bar (no DRM, input or uinput), for checking a layout. Rows:
+/// base layer, the same with its second button pressed, the Fn layer.
+fn render_preview(path: &std::ffi::OsStr) {
+    let (width, height) = (2170u16, 60u16);
+    let (cfg, mut layers) = ConfigManager::new().load_config(width);
+    let gap = 12;
+    let rows = [(0, None), (0, Some(1)), (1, None)];
+    let bar = ImageSurface::create(Format::ARgb32, height as i32, width as i32).unwrap();
+    let out = ImageSurface::create(
+        Format::ARgb32,
+        width as i32,
+        rows.len() as i32 * (height as i32 + gap) - gap,
+    )
+    .unwrap();
+    let c = Context::new(&out).unwrap();
+    c.set_source_rgb(0.5, 0.5, 0.5);
+    c.paint().unwrap();
+    for (row, (layer, pressed)) in rows.into_iter().enumerate() {
