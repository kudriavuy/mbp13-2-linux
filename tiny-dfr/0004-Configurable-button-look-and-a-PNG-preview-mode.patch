+    /// left edge and width of each button in a row `width` px wide: fixed
+    /// widths first, the rest shared by Stretch; Group adds GroupSpacing before
+    /// a button instead of ButtonSpacing. Rounded so that the gaps stay even.
+    fn geometry(&self, config: &Config, width: f64) -> Vec<(f64, f64)> {
+        let gap = |i: usize, b: &Button| match (i, b.group) {
+            (0, _) => 0.0,
+            (_, true) => config.group_spacing,
+            (_, false) => config.button_spacing,
+        };
+        let mut free = width;
+        let mut shares = 0usize;
+        for (i, (stretch, b)) in self.buttons.iter().enumerate() {
+            free -= gap(i, b);
+            match b.fixed_width {
+                Some(w) => free -= w,
+                None => {
+                    // a stretched button also covers the gaps it spans
+                    free -= (*stretch - 1) as f64 * config.button_spacing;
+                    shares += *stretch;
+                }
+            }
+        }
+        let share = if shares > 0 { (free / shares as f64).max(0.0) } else { 0.0 };
+        let mut x = 0.0;
+        let mut out = Vec::with_capacity(self.buttons.len());
+        for (i, (stretch, b)) in self.buttons.iter().enumerate() {
+            x += gap(i, b);
+            let w = b.fixed_width.unwrap_or(
+                *stretch as f64 * share + (*stretch - 1) as f64 * config.button_spacing,
+            );
+            let left = x.floor();
+            out.push((left, (x + w).floor() - left));
+            x += w;
+        }
+        out
+    }
