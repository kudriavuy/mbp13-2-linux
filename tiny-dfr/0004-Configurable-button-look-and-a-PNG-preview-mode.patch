+# Look of the buttons. Without these keys the upstream look stays.
+# FontSize = 32            # text size in px
+# IconSize = 48            # default icon size in px (IconWidth/IconHeight per button win)
+# ButtonColor = "#333333"  # button background, and while pressed
+# ButtonActiveColor = "#666666"
+# ButtonHeight = 0         # px; 0 means 70 % of the bar
+# ButtonRadius = 8         # corner radius in px
+# ButtonSpacing = 16       # gap between buttons in px
+# GroupSpacing = 16        # gap before a button with Group = true (default ButtonSpacing)
+# EscWidth = 0             # fixed width of the Esc key tiny-dfr adds; 0 or unset: like the others
+# Per button: Width = <px> gives a fixed width (Stretch shares the rest),
+# Group = true puts a GroupSpacing gap before it. A button with neither Text
+# nor Icon is an empty spacer, which can be used to push others aside.
+
 # Set this to false if you want the brightness of the touchbar
 # to be set to a static value instead of following the primary
 # screen's brightness
