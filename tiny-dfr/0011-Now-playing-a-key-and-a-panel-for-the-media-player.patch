+/// One command line to the helper; Err(()) if it is not running
+pub fn bridge_send(line: &str) -> Result<(), ()> {
+    // non-blocking: no reader (helper not running) is ENXIO
+    let mut fifo = OpenOptions::new()
+        .write(true)
+        .custom_flags(libc::O_NONBLOCK)
+        .open(BRIDGE_CMD)
+        .map_err(|_| ())?;
+    fifo.write_all(format!("{line}\n").as_bytes()).map_err(|_| ())
+}
