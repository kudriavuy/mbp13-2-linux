+/// The now-playing panel over `layer`: right of Esc to the end
+fn media_layout(cfg: &Config, layer: &FunctionLayer, width: u16) -> media::Layout {
+    let avail = width as f64 - pixel_shift_width(cfg);
+    let left = if width >= 2170 {
+        let (l, w) = layer.geometry(cfg, avail)[0];
+        l + w + cfg.group_spacing
+    } else {
+        0.0
+    };
+    media::Layout::new(cfg, left, avail)
+}
+
+/// A key of the now-playing panel: to the helper (MPRIS), else as a media key
+fn media_key<F: AsRawFd>(key: media::Key, uinput: &mut UInputHandle<F>) {
+    let (cmd, fallback) = match key {
+        media::Key::Previous => ("media previous", Key::PreviousSong),
+        media::Key::PlayPause => ("media playpause", Key::PlayPause),
+        media::Key::Next => ("media next", Key::NextSong),
+    };
+    if slider::bridge_send(cmd).is_err() {
+        toggle_keys(uinput, &vec![fallback], 1);
+        toggle_keys(uinput, &vec![fallback], 0);
+    }
+}
