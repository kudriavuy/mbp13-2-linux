+/// .../nowplaying: "key value" lines
+#[derive(Default, Clone, PartialEq, Debug)]
+pub struct NowPlaying {
+    pub playing: bool,
+    pub title: String,
+    pub artist: String,
+    pub length_us: i64,
+    pub position_us: i64,
+    // wall clock (ms since the epoch) when position_us was read
+    pub at_ms: i64,
+    pub rate: f64,
+    pub can_seek: bool,
+}
+
+impl NowPlaying {
+    fn parse(text: &str) -> Option<NowPlaying> {
+        let mut np = NowPlaying { rate: 1.0, ..Default::default() };
+        let mut status = "";
+        for line in text.lines() {
+            let (key, value) = line.split_once(' ').unwrap_or((line, ""));
+            match key {
+                "status" => status = if value == "Playing" { "Playing" } else if value == "Paused" { "Paused" } else { "" },
+                "title" => np.title = value.to_string(),
+                "artist" => np.artist = value.to_string(),
+                "length_us" => np.length_us = value.parse().unwrap_or(0),
+                "position_us" => np.position_us = value.parse().unwrap_or(0),
+                "at_ms" => np.at_ms = value.parse().unwrap_or(0),
+                "rate" => np.rate = value.parse().unwrap_or(1.0),
+                "can_seek" => np.can_seek = value == "1",
+                _ => {}
+            }
+        }
+        np.playing = status == "Playing";
+        (!status.is_empty()).then_some(np)
+    }
+    /// Where it is now, in µs: while playing it runs on from the last report
+    pub fn position_now(&self) -> i64 {
+        let mut pos = self.position_us;
+        if self.playing {
+            let now_ms = SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |d| d.as_millis() as i64);
+            pos += ((now_ms - self.at_ms).max(0) as f64 * 1000.0 * self.rate) as i64;
+        }
+        if self.length_us > 0 {
+            pos = pos.min(self.length_us);
+        }
+        pos.max(0)
+    }
 }
 
