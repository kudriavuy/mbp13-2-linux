+// "Now playing" (macOS style): a button (Command = "NowPlaying") shown while
+// the helper follows a media player with a track; tapped it opens a panel
+// over the row right of Esc: a round close button, previous / play-pause /
+// next, and a capsule with title, artist, time and a scrubber. Dragging the
+// scrubber seeks on release. Commands go to the helper (mbp-touchbar-bridge:
+// MPRIS of that player); without it the three keys are media keys.
+use crate::{config::Config, state::NowPlaying};
+use cairo::Context;
+use std::f64::consts::TAU;
+
+const CLOSE_DIAMETER: f64 = 44.0;
+const CLOSE_COLOR: f64 = 0.70;
+const CLOSE_BOX: f64 = 72.0;
+const KEY_WIDTH: f64 = 120.0;
+const TITLE_SIZE: f64 = 22.0;
+const TIME_SIZE: f64 = 18.0;
+const TRACK_HEIGHT: f64 = 5.0;
+const KNOB_RADIUS: f64 = 8.0;
+const PAD: f64 = 18.0;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Key {
+    Previous,
+    PlayPause,
+    Next,
+}
+
+pub enum Hit {
+    Close,
+    Key(Key),
+    Scrub,
+    Outside,
+}
+
+/// Parts in bar coordinates without pixel shift
+pub struct Layout {
+    pub left: f64,
+    pub close: (f64, f64),
+    pub keys: [(f64, f64); 3],
+    pub capsule: (f64, f64),
+    pub track: (f64, f64),
+}
+
+impl Layout {
+    /// `left`: first px after Esc and its gap, `right`: end of the row
+    pub fn new(cfg: &Config, left: f64, right: f64) -> Layout {
+        let close = (left, CLOSE_BOX);
+        let mut x = close.0 + close.1 + cfg.group_spacing;
+        let mut keys = [(0.0, 0.0); 3];
+        for k in &mut keys {
+            *k = (x, KEY_WIDTH);
+            x += KEY_WIDTH + cfg.button_spacing;
+        }
+        let capsule = (x - cfg.button_spacing + cfg.group_spacing, 0.0);
+        let capsule = (capsule.0, (right - capsule.0).max(KEY_WIDTH));
+        let track = (capsule.0 + PAD + KNOB_RADIUS, capsule.0 + capsule.1 - PAD - KNOB_RADIUS);
+        Layout { left, close, keys, capsule, track }
+    }
+    pub fn hit(&self, x: f64) -> Hit {
+        let within = |(l, w): (f64, f64)| x >= l - 4.0 && x < l + w + 4.0;
+        if x < self.left - 4.0 {
+            Hit::Outside
+        } else if within(self.close) {
+            Hit::Close
+        } else if within(self.keys[0]) {
+            Hit::Key(Key::Previous)
+        } else if within(self.keys[1]) {
+            Hit::Key(Key::PlayPause)
+        } else if within(self.keys[2]) {
+            Hit::Key(Key::Next)
+        } else if within(self.capsule) {
+            Hit::Scrub
+        } else {
+            Hit::Outside
+        }
+    }
+    pub fn fraction_at(&self, x: f64) -> f64 {
+        ((x - self.track.0) / (self.track.1 - self.track.0)).clamp(0.0, 1.0)
+    }
+}
+
+pub struct Panel {
+    // a key held (shown pressed)
+    pub pressed: Option<(u32, Key)>,
+    // the scrubber held: touch slot and where (0..1)
+    pub scrub: Option<(u32, f64)>,
+}
+
+fn rounded_rect(c: &Context, x: f64, y: f64, w: f64, h: f64, r: f64) {
+    let r = r.min(h / 2.0).min(w / 2.0);
+    c.new_sub_path();
+    c.arc(x + w - r, y + r, r, (-90.0f64).to_radians(), 0.0);
+    c.arc(x + w - r, y + h - r, r, 0.0, (90.0f64).to_radians());
+    c.arc(x + r, y + h - r, r, (90.0f64).to_radians(), (180.0f64).to_radians());
+    c.arc(x + r, y + r, r, (180.0f64).to_radians(), (270.0f64).to_radians());
+    c.close_path();
+}
+
+fn triangle(c: &Context, x: f64, cy: f64, w: f64, h: f64, right: bool) {
+    if right {
+        c.move_to(x, cy - h / 2.0);
+        c.line_to(x + w, cy);
+        c.line_to(x, cy + h / 2.0);
+    } else {
+        c.move_to(x + w, cy - h / 2.0);
+        c.line_to(x, cy);
+        c.line_to(x + w, cy + h / 2.0);
+    }
+    c.close_path();
+}
+
+fn time(us: i64) -> String {
+    let s = (us / 1_000_000).max(0);
+    format!("{}:{:02}", s / 60, s % 60)
+}
+
+/// `text` cut to fit `width` at the current font size, with an ellipsis
+fn fit(c: &Context, text: &str, width: f64) -> String {
+    if c.text_extents(text).map_or(0.0, |e| e.x_advance()) <= width {
+        return text.to_string();
+    }
+    let mut chars: Vec<char> = text.chars().collect();
+    while !chars.is_empty() {
+        chars.pop();
+        let t: String = chars.iter().collect::<String>().trim_end().to_string() + "…";
+        if c.text_extents(&t).map_or(0.0, |e| e.x_advance()) <= width {
+            return t;
+        }
+    }
+    String::new()
+}
+
+impl Panel {
+    pub fn new() -> Panel {
+        Panel { pressed: None, scrub: None }
+    }
+
+    /// `full`: also the close button and the keys (else only the capsule,
+    /// for the running time). The bar around it must be cleared by the caller.
+    pub fn draw(&self, c: &Context, cfg: &Config, layout: &Layout, np: Option<&NowPlaying>, height: f64, (sx, sy): (f64, f64), full: bool) {
+        let bh = if cfg.button_height > 0.0 { cfg.button_height.min(height) } else { height * 0.7 };
+        let top = (height - bh) / 2.0;
+        let cy = height / 2.0 + sy;
+        if full {
+            let cx = layout.close.0 + layout.close.1 / 2.0 + sx;
+            c.set_source_rgb(CLOSE_COLOR, CLOSE_COLOR, CLOSE_COLOR);
+            c.arc(cx, height / 2.0, CLOSE_DIAMETER / 2.0, 0.0, TAU);
+            c.fill().unwrap();
+            let arm = 7.5;
+            c.set_source_rgb(0.0, 0.0, 0.0);
+            c.set_line_width(3.5);
+            c.set_line_cap(cairo::LineCap::Round);
+            c.move_to(cx - arm, height / 2.0 - arm);
+            c.line_to(cx + arm, height / 2.0 + arm);
+            c.move_to(cx + arm, height / 2.0 - arm);
+            c.line_to(cx - arm, height / 2.0 + arm);
+            c.stroke().unwrap();
+            let playing = np.is_some_and(|n| n.playing);
+            for (i, key) in [Key::Previous, Key::PlayPause, Key::Next].into_iter().enumerate() {
+                let (l, w) = layout.keys[i];
+                let pressed = self.pressed.is_some_and(|(_, k)| k == key);
+                let (r, g, b) = if pressed { cfg.button_active_color } else { cfg.button_color };
+                c.set_source_rgb(r, g, b);
+                rounded_rect(c, l + sx, top, w, bh, cfg.button_radius);
+                c.fill().unwrap();
+                c.set_source_rgb(1.0, 1.0, 1.0);
+                let mx = l + w / 2.0 + sx;
+                match key {
+                    Key::Previous => {
+                        triangle(c, mx - 18.0, cy, 18.0, 20.0, false);
+                        triangle(c, mx, cy, 18.0, 20.0, false);
+                        c.fill().unwrap();
+                    }
+                    Key::Next => {
+                        triangle(c, mx - 18.0, cy, 18.0, 20.0, true);
+                        triangle(c, mx, cy, 18.0, 20.0, true);
+                        c.fill().unwrap();
+                    }
+                    Key::PlayPause if playing => {
+                        c.rectangle(mx - 10.0, cy - 11.0, 7.0, 22.0);
+                        c.rectangle(mx + 3.0, cy - 11.0, 7.0, 22.0);
+                        c.fill().unwrap();
+                    }
+                    Key::PlayPause => {
+                        triangle(c, mx - 8.0, cy, 20.0, 24.0, true);
+                        c.fill().unwrap();
+                    }
+                }
+            }
+        }
+        // capsule: title — artist, time, scrubber
+        let (cl, cw) = layout.capsule;
+        c.set_source_rgb(0.0, 0.0, 0.0);
+        c.rectangle(cl + sx - 1.0, 0.0, cw + 2.0, height);
+        c.fill().unwrap();
+        let (r, g, b) = cfg.button_color;
+        c.set_source_rgb(r, g, b);
+        rounded_rect(c, cl + sx, top, cw, bh, cfg.button_radius);
+        c.fill().unwrap();
+        let Some(np) = np else {
+            c.set_font_size(TITLE_SIZE);
+            c.set_source_rgb(0.6, 0.6, 0.6);
+            c.move_to(cl + PAD + sx, cy + 7.0);
+            let _ = c.show_text("—");
+            return;
+        };
+        let pos = self.scrub.map_or(np.position_now(), |(_, f)| (f * np.length_us as f64) as i64);
+        let times = if np.length_us > 0 {
+            format!("{} / {}", time(pos), time(np.length_us))
+        } else {
+            time(pos)
+        };
+        c.set_font_size(TIME_SIZE);
+        let tw = c.text_extents(&times).map_or(0.0, |e| e.x_advance());
+        c.set_source_rgb(0.7, 0.7, 0.7);
+        c.move_to(cl + cw - PAD - tw + sx, top + 23.0 + sy);
+        let _ = c.show_text(&times);
+        c.set_font_size(TITLE_SIZE);
+        let room = cw - 2.0 * PAD - tw - 16.0;
+        let title = fit(c, &np.title, room);
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        c.move_to(cl + PAD + sx, top + 24.0 + sy);
+        let _ = c.show_text(&title);
+        let used = c.text_extents(&title).map_or(0.0, |e| e.x_advance());
+        if !np.artist.is_empty() && used < room - 40.0 {
+            let artist = fit(c, &format!("  —  {}", np.artist), room - used);
+            c.set_source_rgb(0.62, 0.62, 0.62);
+            let _ = c.show_text(&artist);
+        }
+        // scrubber
+        let ty = top + bh - 16.0;
+        let frac = if np.length_us > 0 { pos as f64 / np.length_us as f64 } else { 0.0 };
+        let (t0, t1) = layout.track;
+        c.set_source_rgb(0.40, 0.40, 0.42);
+        rounded_rect(c, t0 + sx, ty - TRACK_HEIGHT / 2.0, t1 - t0, TRACK_HEIGHT, TRACK_HEIGHT / 2.0);
+        c.fill().unwrap();
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        let kx = t0 + frac * (t1 - t0);
+        rounded_rect(c, t0 + sx, ty - TRACK_HEIGHT / 2.0, (kx - t0).max(TRACK_HEIGHT), TRACK_HEIGHT, TRACK_HEIGHT / 2.0);
+        c.fill().unwrap();
+        if np.can_seek && np.length_us > 0 {
+            c.arc(kx + sx, ty, KNOB_RADIUS, 0.0, TAU);
+            c.fill().unwrap();
+        }
+    }
+}
