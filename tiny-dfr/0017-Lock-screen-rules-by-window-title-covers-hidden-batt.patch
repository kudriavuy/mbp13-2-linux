+    /// NowPlaying: the player's cover instead of the icon, or the icon again
+    fn show_cover(&mut self, cover: Option<&ButtonImage>) {
+        if self.command != Some(Command::NowPlaying) {
+            return;
+        }
+        match cover {
+            Some(c) => {
+                if self.own_image.is_none() {
+                    self.own_image = Some(self.image.clone());
+                }
+                self.image = c.clone();
+            }
+            None => {
+                if let Some(own) = self.own_image.take() {
+                    self.image = own;
+                }
+            }
+        }
+        self.changed = true;
+    }
+    /// Battery with ShowBelow: hidden unless low or charging; true if that changed
+    fn battery_visibility(&mut self) -> bool {
+        let (Some(limit), ButtonImage::Battery(battery, _, _)) = (self.show_below, &self.image) else {
+            return false;
+        };
+        let (capacity, state) = get_battery_state(battery);
+        let charging = state == BatteryState::Charging && capacity < 100;
+        let hidden = !(capacity < limit || charging);
+        let changed = hidden != self.hidden;
+        self.hidden = hidden;
+        changed
+    }
