 # while Fn is held in the program (labels for its F-keys), instead of F1-F12.
+# While the screen is locked (the helper's .../locked) the bar shows only Esc
+# and LockScreenKeys (default none), and no notification, media or slider.
+# LockScreenKeys = []
+# MatchTitle = ["part of a title", ...] in an [[Apps]] rule: the window title
+# (from the helper's .../title) must contain one of them; Match may be left out
+# (any program). Put such rules before the general ones.
+# ShowBelow = 20 on a Battery key: shown only below that charge or while
+# charging (it takes no room otherwise).
+# Command = "NowPlaying" keys show the player's cover when the helper gives
+# one (nowplaying "art <file>": an SVG next to the state files).
+# AdaptiveBrightness uses the display backlight's own max_brightness.
 # PixelShiftSmooth = true   # false: one whole pixel every 10 s instead of a
 #                           # 4 s animation (fewer frames); no shifting at all
 #                           # while the bar is dark
