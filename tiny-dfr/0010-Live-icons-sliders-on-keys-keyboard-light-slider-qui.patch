@@ -0,0 +1,47 @@
+// What the desktop helper (mbp-touchbar-bridge) reports about the session,
+// for icons that follow it (Live = "Volume" / "Mic"): files in
+// /run/tiny-dfr/bridge, watched with inotify. Missing files: unknown.
+use nix::sys::inotify::{AddWatchFlags, InitFlags, Inotify};
+use std::{fs::read_to_string, os::fd::AsFd};
+
+const DIR: &str = "/run/tiny-dfr/bridge";
+
+#[derive(Default, Clone, PartialEq)]
+pub struct State {
+    /// default sink: volume 0..1 and muted
+    pub volume: Option<(f64, bool)>,
+    /// default source muted
+    pub mic_muted: Option<bool>,
+}
+
+pub struct StateWatch {
+    inotify_fd: Inotify,
+}
+
+impl StateWatch {
+    pub fn new() -> StateWatch {
+        let inotify_fd = Inotify::init(InitFlags::IN_NONBLOCK).unwrap();
+        // no directory (no tmpfiles entry): the icons keep their first image
+        let _ = inotify_fd.add_watch(DIR, AddWatchFlags::IN_CLOSE_WRITE | AddWatchFlags::IN_MOVED_TO);
+        StateWatch { inotify_fd }
+    }
+    /// whether a file changed since the last call
+    pub fn changed(&self) -> bool {
+        self.inotify_fd.read_events().is_ok_and(|evts| !evts.is_empty())
+    }
+    pub fn read(&self) -> State {
+        let volume = read_to_string(format!("{DIR}/volume")).ok().and_then(|s| {
+            let mut w = s.split_whitespace();
+            let v = w.next()?.parse::<f64>().ok()?;
+            let muted = w.next().is_some_and(|m| m == "1");
+            Some((v.clamp(0.0, 1.0), muted))
+        });
+        let mic_muted = read_to_string(format!("{DIR}/mic"))
+            .ok()
+            .map(|s| s.trim() == "1");
+        State { volume, mic_muted }
+    }
+    pub fn fd(&self) -> &impl AsFd {
+        &self.inotify_fd
+    }
+}
