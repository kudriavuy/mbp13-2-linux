@@ -0,0 +1,91 @@
+// Short animations (Animations = true): a pressed key fades in and out, the
+// Control Strip slides in when expanded or collapsed, the slider grows out of
+// its button and shrinks back. The bar takes a full frame in about 11 ms
+// (USB, appletbdrm), so frames come at most every FRAME. Keys are sent at
+// once, never after an animation, and a new touch ends any animation.
+use cairo::{Context, Format, ImageSurface};
+use std::{
+    sync::atomic::{AtomicBool, Ordering},
+    time::{Duration, Instant},
+};
+
+pub const FRAME: Duration = Duration::from_millis(16);
+pub const PRESS_IN: Duration = Duration::from_millis(60);
+pub const PRESS_OUT: Duration = Duration::from_millis(150);
+pub const STRIP: Duration = Duration::from_millis(200);
+pub const SLIDER_OPEN: Duration = Duration::from_millis(150);
+pub const SLIDER_CLOSE: Duration = Duration::from_millis(120);
+// how far the new row of the strip travels while it fades in
+pub const STRIP_SLIDE_PX: f64 = 160.0;
+
+// set from the config; read where no config is at hand (Button::set_active)
+static ENABLED: AtomicBool = AtomicBool::new(false);
+
+pub fn set_enabled(on: bool) {
+    ENABLED.store(on, Ordering::Relaxed);
+}
+
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// 0..1 of the way from `start` through `length`
+pub fn progress(start: Instant, length: Duration) -> f64 {
+    (start.elapsed().as_secs_f64() / length.as_secs_f64()).clamp(0.0, 1.0)
+}
+
+/// ease-out cubic: fast start, gentle stop
+pub fn ease(t: f64) -> f64 {
+    1.0 - (1.0 - t).powi(3)
+}
+
+pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
+    a + (b - a) * t
+}
+
+pub fn lerp_color(a: (f64, f64, f64), b: (f64, f64, f64), t: f64) -> (f64, f64, f64) {
+    (lerp(a.0, b.0, t), lerp(a.1, b.1, t), lerp(a.2, b.2, t))
+}
+
+/// A copy of what is on the bar now (the row an animation starts from)
+pub fn snapshot(src: &ImageSurface) -> ImageSurface {
+    let copy = ImageSurface::create(Format::ARgb32, src.width(), src.height()).unwrap();
+    let c = Context::new(&copy).unwrap();
+    c.set_source_surface(src, 0.0, 0.0).unwrap();
+    c.paint().unwrap();
+    drop(c);
+    copy
+}
+
+/// The strip changing rows: the old row fades out, the new one fades in
+/// while it slides `STRIP_SLIDE_PX` into place; left of `fixed_until` (Esc)
+/// nothing moves. Surfaces are the bar's portrait framebuffer, so a shift
+/// along the bar is a shift in y.
+pub struct RowTransition {
+    pub start: Instant,
+    pub from: ImageSurface,
+    pub to: ImageSurface,
+    // +1: the new row comes from the right (expanding), -1 from the left
+    pub direction: f64,
+    pub fixed_until: f64,
+}
+
+impl RowTransition {
+    pub fn done(&self) -> bool {
+        progress(self.start, STRIP) >= 1.0
+    }
+    pub fn compose(&self, onto: &ImageSurface) {
+        let e = ease(progress(self.start, STRIP));
+        let c = Context::new(onto).unwrap();
+        c.set_source_surface(&self.to, 0.0, 0.0).unwrap();
+        c.paint().unwrap();
+        c.rectangle(0.0, self.fixed_until, onto.width() as f64, onto.height() as f64 - self.fixed_until);
+        c.clip();
+        c.set_source_rgb(0.0, 0.0, 0.0);
+        c.paint().unwrap();
+        c.set_source_surface(&self.from, 0.0, 0.0).unwrap();
+        c.paint_with_alpha(1.0 - e).unwrap();
+        c.set_source_surface(&self.to, 0.0, self.direction * (1.0 - e) * STRIP_SLIDE_PX).unwrap();
+        c.paint_with_alpha(e).unwrap();
+    }
+}
