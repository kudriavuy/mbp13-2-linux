 # Group = true puts a GroupSpacing gap before it. A button with neither Text
 # nor Icon is an empty spacer, which can be used to push others aside.
 
+# Control Strip (macOS style). With ControlStripKeys set, MediaLayerKeys is the
+# expanded strip and the other row is: AppLayerKeys, free space, ControlStripKeys
+# at the right end (the collapsed strip). A button with Command = "Expand" or
+# "Collapse" switches between the two when released (it may also have an Action).
+# ControlStripDefault ("Expanded" or "Collapsed") is the state at start and
+# whenever /run/tiny-dfr/layer changes. Without ControlStripKeys nothing changes.
+# ControlStripDefault = "Expanded"
+# ControlStripKeys = [
+#     { Text = "<", Command = "Expand", Width = 72 },
+#     { Icon = "volume_off", Action = "Mute", Width = 120 }
+# ]
+# AppLayerKeys = []
+
 # Set this to false if you want the brightness of the touchbar
 # to be set to a static value instead of following the primary
 # screen's brightness
