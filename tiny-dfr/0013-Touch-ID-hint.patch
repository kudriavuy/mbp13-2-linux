index 0000000..888b187
--- /dev/null
+++ b/src/touchid.rs
@@ -0,0 +1,76 @@
+// Touch ID hint (macOS style): while something waits for a fingerprint
+// (sudo, the lock screen; reported by root's mbp-touchid-hint watching
+// fprintd) the bar right of Esc shows the fingerprint icon and TouchIdText
+// with an arrow to the sensor, which is the key right of the Touch Bar. A
+// match flashes a green tick, a failure TouchIdFailText, a bad read
+// TouchIdRetryText.
+use crate::{config::Config, state::TouchId, Button};
+use cairo::Context;
+use std::f64::consts::TAU;
+
+const ICON_BOX: f64 = 56.0;
+const ARROW_WIDTH: f64 = 44.0;
+const RIGHT_PAD: f64 = 16.0;
+// how far the arrow moves while it waits (animations)
+pub const ARROW_SWING_PX: f64 = 8.0;
+
+/// The arrow's area, for redrawing only it: (left, width)
+pub fn arrow_area(right: f64) -> (f64, f64) {
+    (right - RIGHT_PAD - ARROW_WIDTH - ARROW_SWING_PX - 2.0, ARROW_WIDTH + ARROW_SWING_PX + 4.0)
+}
+
+/// `left`..`right`: the part of the bar it covers (cleared here); `swing`
+/// 0..1 moves the arrow towards the sensor
+pub fn draw(c: &Context, cfg: &Config, (left, right): (f64, f64), height: f64, (sx, sy): (f64, f64), kind: TouchId, icon: Option<&Button>, swing: f64) {
+    c.set_source_rgb(0.0, 0.0, 0.0);
+    c.rectangle(left + sx, 0.0, right - left + 2.0, height);
+    c.fill().unwrap();
+    let cy = height / 2.0 + sy;
+    // arrow to the sensor
+    let ax = right - RIGHT_PAD - ARROW_WIDTH + swing * ARROW_SWING_PX + sx;
+    let (r, g, b) = match kind {
+        TouchId::Match => (0.19, 0.82, 0.35),
+        TouchId::NoMatch => (1.0, 0.27, 0.23),
+        TouchId::Retry => (1.0, 0.62, 0.04),
+        TouchId::Waiting => (1.0, 1.0, 1.0),
+    };
+    c.set_source_rgb(r, g, b);
+    c.set_line_width(3.5);
+    c.set_line_cap(cairo::LineCap::Round);
+    c.set_line_join(cairo::LineJoin::Round);
+    c.move_to(ax, cy);
+    c.line_to(ax + ARROW_WIDTH - 4.0, cy);
+    c.move_to(ax + ARROW_WIDTH - 16.0, cy - 12.0);
+    c.line_to(ax + ARROW_WIDTH - 4.0, cy);
+    c.line_to(ax + ARROW_WIDTH - 16.0, cy + 12.0);
+    c.stroke().unwrap();
+    // text left of the arrow
+    let text = match kind {
+        TouchId::Waiting | TouchId::Match => cfg.touchid_text.as_str(),
+        TouchId::Retry => cfg.touchid_retry_text.as_str(),
+        TouchId::NoMatch => cfg.touchid_fail_text.as_str(),
+    };
+    c.set_font_face(&cfg.font_face);
+    c.set_font_size(cfg.font_size);
+    let ext = c.text_extents(text).unwrap();
+    let tx = right - RIGHT_PAD - ARROW_WIDTH - ARROW_SWING_PX - 20.0 - ext.x_advance();
+    c.move_to(tx + sx, (height / 2.0 + ext.height() / 2.0).round() + sy);
+    let _ = c.show_text(text);
+    // fingerprint, or a green tick on a match
+    let ix = tx - 12.0 - ICON_BOX;
+    if kind == TouchId::Match {
+        let (mx, r0) = (ix + ICON_BOX / 2.0 + sx, 20.0);
+        c.set_source_rgb(0.19, 0.82, 0.35);
+        c.arc(mx, cy, r0, 0.0, TAU);
+        c.fill().unwrap();
+        c.set_source_rgb(0.0, 0.0, 0.0);
+        c.set_line_width(4.0);
+        c.move_to(mx - 9.0, cy + 1.0);
+        c.line_to(mx - 2.0, cy + 8.0);
+        c.line_to(mx + 10.0, cy - 7.0);
+        c.stroke().unwrap();
+    } else if let Some(icon) = icon {
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        icon.render(c, height as i32, ix + sx, ICON_BOX as u64, sy);
+    }
+}
