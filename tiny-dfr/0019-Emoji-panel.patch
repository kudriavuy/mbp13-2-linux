+/// The round close button (×) of a panel, centred at `cx`
+pub fn close_button(c: &Context, cx: f64, height: f64) {
+    c.set_source_rgb(CLOSE_COLOR, CLOSE_COLOR, CLOSE_COLOR);
+    c.arc(cx, height / 2.0, CLOSE_DIAMETER / 2.0, 0.0, TAU);
