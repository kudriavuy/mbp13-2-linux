+    c.move_to(cx - arm, height / 2.0 - arm);
+    c.line_to(cx + arm, height / 2.0 + arm);
+    c.move_to(cx + arm, height / 2.0 - arm);
+    c.line_to(cx - arm, height / 2.0 + arm);
+    c.stroke().unwrap();
+}
