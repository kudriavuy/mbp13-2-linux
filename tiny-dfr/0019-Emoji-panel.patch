index 0000000..d97364b
--- /dev/null
+++ b/src/emoji.rs
@@ -0,0 +1,393 @@
+// The emoji panel (macOS style): a key (Command = "Emoji") opens it over the
+// program's part of the row (Esc and the Control Strip stay): a round close
+// button, a key with the current category, and one row of all emoji that
+// scrolls with the finger and runs on after a flick. The category key shows
+// the categories instead; one tapped jumps to its start. A tapped emoji goes
+// to the helper ("emoji <text>"): it puts it on the clipboard, says so in
+// .../paste, and tiny-dfr presses paste (Ctrl+V, Ctrl+Shift+V in the programs
+// of EmojiPasteShift); the helper puts the old clipboard back after it.
+// The list: /usr/share/tiny-dfr/emoji.txt (from Unicode's emoji-test.txt),
+// recently used ones first (.../emoji-recent). Each emoji is drawn once by
+// Pango (sequences, flags, colour glyphs; librsvg would draw them as black
+// outlines) and kept.
+use crate::{config::Config, media};
+use cairo::{Context, Format, ImageSurface};
+use pangocairo::{functions as pc, pango};
+use std::{
+    collections::HashMap,
+    fs::read_to_string,
+    time::{Duration, Instant},
+};
+
+const LIST: &str = "/usr/share/tiny-dfr/emoji.txt";
+const CLOSE_BOX: f64 = 72.0;
+const CATEGORY_WIDTH: f64 = 80.0;
+// one emoji's place in the row, and the size it is drawn at
+const PITCH: f64 = 64.0;
+const GLYPH: i32 = 38;
+// a category in the category row
+const CATEGORY_PITCH: f64 = 84.0;
+const RECENT_ICON: &str = "\u{1F552}";
+// a flick: speed it keeps (px/s), how fast it fades, when it stops
+const FLING_MIN: f64 = 150.0;
+const FLING_TAU: f64 = 0.45;
+const FLING_STOP: f64 = 15.0;
+// the finger's speed: from its moves in the last this long
+const VELOCITY_WINDOW: Duration = Duration::from_millis(80);
+const MAX_CACHED: usize = 600;
+
+pub struct Group {
+    pub icon: String,
+    pub start: usize,
+}
+
+pub struct Catalog {
+    pub items: Vec<String>,
+    pub groups: Vec<Group>,
+}
+
+impl Catalog {
+    /// The list with `recent` (most recent first) as its first group
+    pub fn load(recent: &[String]) -> Option<Catalog> {
+        let text = read_to_string(LIST).map_err(|e| eprintln!("{LIST}: {e}")).ok()?;
+        let mut items: Vec<String> = Vec::new();
+        let mut groups = Vec::new();
+        if !recent.is_empty() {
+            groups.push(Group { icon: RECENT_ICON.into(), start: 0 });
+            items.extend(recent.iter().cloned());
+        }
+        let mut lines = text.lines().filter(|l| !l.starts_with('#'));
+        while let Some(head) = lines.next() {
+            let Some(icon) = head.strip_prefix('@').and_then(|h| h.split_whitespace().nth(1)) else {
+                continue;
+            };
+            groups.push(Group { icon: icon.to_string(), start: items.len() });
+            items.extend(lines.next().unwrap_or("").split_whitespace().map(str::to_string));
+        }
+        (!items.is_empty()).then_some(Catalog { items, groups })
+    }
+}
+
+pub enum Hit {
+    Close,
+    Category,
+    Strip,
+    Outside,
+}
+
+/// Parts in bar coordinates without pixel shift
+pub struct Layout {
+    pub left: f64,
+    pub close: (f64, f64),
+    pub category: (f64, f64),
+    pub strip: (f64, f64),
+    pub right: f64,
+}
+
+impl Layout {
+    /// `left`..`right`: the program's part of the row
+    pub fn new(cfg: &Config, left: f64, right: f64) -> Layout {
+        let close = (left, CLOSE_BOX);
+        let category = (close.0 + close.1 + cfg.group_spacing, CATEGORY_WIDTH);
+        let s = category.0 + category.1 + cfg.group_spacing;
+        let strip = (s, (right - s).max(PITCH));
+        Layout { left, close, category, strip, right: strip.0 + strip.1 }
+    }
+    pub fn hit(&self, x: f64) -> Hit {
+        let within = |(l, w): (f64, f64)| x >= l - 4.0 && x < l + w + 4.0;
+        if x < self.left - 4.0 || x >= self.right + 4.0 {
+            Hit::Outside
+        } else if within(self.close) {
+            Hit::Close
+        } else if within(self.category) {
+            Hit::Category
+        } else if within(self.strip) {
+            Hit::Strip
+        } else {
+            Hit::Outside
+        }
+    }
+}
+
+/// A finger on the row
+struct Touch {
+    slot: u32,
+    x0: f64,
+    offset0: f64,
+    dragging: bool,
+    // recent (time, x) for the speed at release
+    trail: Vec<(Instant, f64)>,
+}
+
+pub struct Panel {
+    pub catalog: Catalog,
+    /// how far the row is scrolled (px from the first emoji)
+    offset: f64,
+    touch: Option<Touch>,
+    /// the emoji (or category, while choosing) under a finger that has not slid
+    pub pressed: Option<(u32, usize)>,
+    /// the category key held
+    pub category_held: Option<u32>,
+    /// the category row is shown instead of the emoji
+    pub choosing: bool,
+    /// running on after a flick: speed in px/s (positive: towards the end)
+    fling: Option<(f64, Instant)>,
+    cache: HashMap<String, ImageSurface>,
+    font: String,
+}
+
+impl Panel {
+    pub fn new(cfg: &Config, recent: &[String]) -> Option<Panel> {
+        Some(Panel {
+            catalog: Catalog::load(recent)?,
+            offset: 0.0,
+            touch: None,
+            pressed: None,
+            category_held: None,
+            choosing: false,
+            fling: None,
+            cache: HashMap::new(),
+            font: cfg.emoji_font.clone(),
+        })
+    }
+
+    /// The PNG preview: scrolled to `group`, an emoji pressed, choosing
+    pub fn preview(&mut self, layout: &Layout, group: usize, pressed: Option<usize>, choosing: bool) {
+        let start = self.catalog.groups.get(group).map_or(0, |g| g.start);
+        self.offset = (start as f64 * PITCH).min(self.max_offset(layout));
+        self.pressed = pressed.map(|i| (0, start + i));
+        self.choosing = choosing;
+    }
+
+    fn max_offset(&self, layout: &Layout) -> f64 {
+        (self.catalog.items.len() as f64 * PITCH - layout.strip.1).max(0.0)
+    }
+
+    /// The emoji at `x` (bar coordinates without pixel shift), if any
+    fn item_at(&self, layout: &Layout, x: f64) -> Option<usize> {
+        let i = ((x - layout.strip.0 + self.offset) / PITCH).floor();
+        (i >= 0.0 && (i as usize) < self.catalog.items.len()).then_some(i as usize)
+    }
+
+    fn category_at(&self, layout: &Layout, x: f64) -> Option<usize> {
+        let i = ((x - layout.strip.0) / CATEGORY_PITCH).floor();
+        (i >= 0.0 && (i as usize) < self.catalog.groups.len()).then_some(i as usize)
+    }
+
+    /// The category the row's left end is in
+    pub fn current_group(&self) -> usize {
+        let first = (self.offset / PITCH + 0.5) as usize;
+        self.catalog.groups.iter().rposition(|g| g.start <= first).unwrap_or(0)
+    }
+
+    /// Whether this finger scrolls or holds the row
+    pub fn touching(&self, slot: u32) -> bool {
+        self.touch.as_ref().is_some_and(|t| t.slot == slot)
+    }
+
+    pub fn moving(&self) -> bool {
+        self.fling.is_some()
+    }
+
+    /// One step of a flick; false when it has stopped
+    pub fn step(&mut self, layout: &Layout) -> bool {
+        let Some((v, at)) = self.fling else { return false };
+        let dt = at.elapsed().as_secs_f64();
+        let v1 = v * (-dt / FLING_TAU).exp();
+        // the distance run over dt with the speed fading exponentially
+        self.offset += v * FLING_TAU * (1.0 - (-dt / FLING_TAU).exp());
+        let max = self.max_offset(layout);
+        let stopped = v1.abs() < FLING_STOP || self.offset <= 0.0 || self.offset >= max;
+        self.offset = self.offset.clamp(0.0, max);
+        self.fling = (!stopped).then_some((v1, Instant::now()));
+        true
+    }
+
+    pub fn down(&mut self, layout: &Layout, slot: u32, x: f64) {
+        // a touch stops a flick (and is then not a tap)
+        let was_moving = self.fling.take().is_some();
+        if self.choosing {
+            self.pressed = self.category_at(layout, x).map(|i| (slot, i));
+            return;
+        }
+        self.touch = Some(Touch { slot, x0: x, offset0: self.offset, dragging: was_moving, trail: vec![(Instant::now(), x)] });
+        self.pressed = if was_moving { None } else { self.item_at(layout, x).map(|i| (slot, i)) };
+    }
+
+    /// true when it is this panel's finger
+    pub fn motion(&mut self, layout: &Layout, slot: u32, x: f64) -> bool {
+        if self.choosing {
+            if self.pressed.is_some_and(|(s, _)| s == slot) {
+                self.pressed = self.category_at(layout, x).map(|i| (slot, i));
+                return true;
+            }
+            return false;
+        }
+        let max = self.max_offset(layout);
+        let Some(t) = self.touch.as_mut().filter(|t| t.slot == slot) else { return false };
+        if !t.dragging && (x - t.x0).abs() > crate::slider::DRAG_THRESHOLD_PX {
+            t.dragging = true;
+            // the row follows the finger from where it is now, without a jump
+            t.x0 = x;
+            self.pressed = None;
+        }
+        if t.dragging {
+            self.offset = (t.offset0 - (x - t.x0)).clamp(0.0, max);
+        }
+        let now = Instant::now();
+        t.trail.push((now, x));
+        t.trail.retain(|&(at, _)| now.duration_since(at) <= VELOCITY_WINDOW);
+        true
+    }
+
+    /// The finger went up: the emoji tapped, if any
+    pub fn up(&mut self, layout: &Layout, slot: u32) -> Option<String> {
+        if self.choosing {
+            let Some((s, i)) = self.pressed.filter(|(s, _)| *s == slot) else { return None };
+            let _ = s;
+            self.pressed = None;
+            self.choosing = false;
+            self.offset = (self.catalog.groups[i].start as f64 * PITCH).min(self.max_offset(layout));
+            return None;
+        }
+        let t = self.touch.take().filter(|t| t.slot == slot)?;
+        if t.dragging {
+            if let (Some(&(t0, x0)), Some(&(t1, x1))) = (t.trail.first(), t.trail.last()) {
+                let dt = t1.duration_since(t0).as_secs_f64();
+                // recent moves only: a finger that stopped before lifting does not fling
+                if dt > 0.005 && t1.elapsed() < VELOCITY_WINDOW {
+                    let v = -(x1 - x0) / dt;
+                    if v.abs() > FLING_MIN {
+                        self.fling = Some((v, Instant::now()));
+                    }
+                }
+            }
+            return None;
+        }
+        let (_, i) = self.pressed.take().filter(|(s, _)| *s == slot)?;
+        Some(self.catalog.items[i].clone())
+    }
+
+    /// A ready-drawn emoji: drawn once by librsvg (Pango lays it out), its
+    /// ink centred in a GLYPH square
+    fn glyph(&mut self, text: &str) -> Option<&ImageSurface> {
+        if !self.cache.contains_key(text) {
+            if self.cache.len() >= MAX_CACHED {
+                self.cache.clear();
+            }
+            let surface = render_glyph(text, &self.font)?;
+            self.cache.insert(text.to_string(), surface);
+        }
+        self.cache.get(text)
+    }
+
+    /// Draw it all; the bar under it is cleared by the caller
+    pub fn draw(&mut self, c: &Context, cfg: &Config, layout: &Layout, height: f64, (sx, sy): (f64, f64)) {
+        let bh = if cfg.button_height > 0.0 { cfg.button_height.min(height) } else { height * 0.7 };
+        let top = (height - bh) / 2.0 + sy;
+        media::close_button(c, layout.close.0 + layout.close.1 / 2.0 + sx, height);
+        // the category key: the current one's emoji (an open one: highlighted)
+        let (l, w) = layout.category;
+        let (r, g, b) = if self.category_held.is_some() || self.choosing { cfg.button_active_color } else { cfg.button_color };
+        c.set_source_rgb(r, g, b);
+        media::rounded_rect(c, l + sx, top, w, bh, cfg.button_radius);
+        c.fill().unwrap();
+        let icon = self.catalog.groups[self.current_group()].icon.clone();
+        self.paint_glyph(c, &icon, l + w / 2.0 + sx, height / 2.0 + sy);
+        // the row, cut at its ends
+        let (sl, sw) = layout.strip;
+        c.save().unwrap();
+        c.rectangle(sl + sx, 0.0, sw, height);
+        c.clip();
+        if self.choosing {
+            let current = self.current_group();
+            for i in 0..self.catalog.groups.len() {
+                let x = sl + i as f64 * CATEGORY_PITCH;
+                let pressed = self.pressed.is_some_and(|(_, p)| p == i);
+                if pressed || i == current {
+                    let (r, g, b) = if pressed { cfg.button_active_color } else { cfg.button_color };
+                    c.set_source_rgb(r, g, b);
+                    media::rounded_rect(c, x + 4.0 + sx, top, CATEGORY_PITCH - 8.0, bh, cfg.button_radius);
+                    c.fill().unwrap();
+                }
+                let icon = self.catalog.groups[i].icon.clone();
+                self.paint_glyph(c, &icon, x + CATEGORY_PITCH / 2.0 + sx, height / 2.0 + sy);
+            }
+        } else {
+            let first = (self.offset / PITCH).floor().max(0.0) as usize;
+            let last = (((self.offset + sw) / PITCH).ceil() as usize).min(self.catalog.items.len());
+            for i in first..last {
+                let x = sl + i as f64 * PITCH - self.offset;
+                if self.pressed.is_some_and(|(_, p)| p == i) {
+                    let (r, g, b) = cfg.button_active_color;
+                    c.set_source_rgb(r, g, b);
+                    media::rounded_rect(c, x + 2.0 + sx, top, PITCH - 4.0, bh, cfg.button_radius);
+                    c.fill().unwrap();
+                }
+                let item = self.catalog.items[i].clone();
+                self.paint_glyph(c, &item, x + PITCH / 2.0 + sx, height / 2.0 + sy);
+            }
+        }
+        c.restore().unwrap();
+    }
+
+    fn paint_glyph(&mut self, c: &Context, text: &str, cx: f64, cy: f64) {
+        if let Some(s) = self.glyph(text) {
+            let x = (cx - GLYPH as f64 / 2.0).round();
+            let y = (cy - GLYPH as f64 / 2.0).round();
+            c.set_source_surface(s, x, y).unwrap();
+            c.paint().unwrap();
+        }
+    }
+}
+
+fn render_glyph(text: &str, font: &str) -> Option<ImageSurface> {
+    // drawn big on a roomy canvas, then its ink is found and fitted
+    let size = GLYPH * 3;
+    let fs = GLYPH * 2;
+    let mut big = ImageSurface::create(Format::ARgb32, size, size).ok()?;
+    {
+        let c = Context::new(&big).ok()?;
+        let layout = pc::create_layout(&c);
+        let mut desc = pango::FontDescription::from_string(font);
+        desc.set_absolute_size(fs as f64 * pango::SCALE as f64);
+        layout.set_font_description(Some(&desc));
+        layout.set_text(text);
+        let (_, logical) = layout.pixel_extents();
+        c.move_to(((size - logical.width()) / 2) as f64, ((size - logical.height()) / 2) as f64);
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        pc::show_layout(&c, &layout);
+    }
+    // the ink's bounds (alpha), in the big canvas
+    let stride = big.stride() as usize;
+    let (mut x0, mut y0, mut x1, mut y1) = (size, size, -1, -1);
+    {
+        let data = big.data().ok()?;
+        for y in 0..size {
+            for x in 0..size {
+                if data[y as usize * stride + x as usize * 4 + 3] > 8 {
+                    x0 = x0.min(x);
+                    x1 = x1.max(x);
+                    y0 = y0.min(y);
+                    y1 = y1.max(y);
+                }
+            }
+        }
+    }
+    if x1 < x0 {
+        return None;
+    }
+    let (w, h) = ((x1 - x0 + 1) as f64, (y1 - y0 + 1) as f64);
+    // down to GLYPH (wide ones, flags, by their width), never up
+    let scale = (GLYPH as f64 / w.max(h)).min(GLYPH as f64 / fs as f64 * 1.25);
+    let out = ImageSurface::create(Format::ARgb32, GLYPH, GLYPH).ok()?;
+    let c = Context::new(&out).ok()?;
+    c.translate(GLYPH as f64 / 2.0, GLYPH as f64 / 2.0);
+    c.scale(scale, scale);
+    c.translate(-(x0 as f64 + w / 2.0), -(y0 as f64 + h / 2.0));
+    c.set_source_surface(&big, 0.0, 0.0).ok()?;
+    c.source().set_filter(cairo::Filter::Best);
+    c.paint().ok()?;
+    drop(c);
+    Some(out)
+}
