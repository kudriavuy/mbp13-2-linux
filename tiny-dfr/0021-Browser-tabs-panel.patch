diff --git a/src/tabs.rs b/src/tabs.rs
new file mode 100644
index 0000000..1d54cf2
--- /dev/null
+++ b/src/tabs.rs
@@ -0,0 +1,217 @@
+// The browser tabs panel (like Safari's Touch Bar): a key (Command = "Tabs")
+// opens it over the program's part of the row (Esc and the Control Strip
+// stay): a round close button, a new-tab key (Ctrl+T) and a row of the
+// browser's tabs - icon and title, the active one lighter - that scrolls
+// with the finger and runs on after a flick. A tapped tab goes to the helper
+// ("tab <id>"), which switches to it. The helper lists the tabs from
+// plasma-browser-integration (its KRunner tabs runner) into .../tabs and
+// .../tab-<id>.png when asked ("tabs refresh": on opening, and whenever the
+// window title changes while it is open).
+use crate::{
+    config::Config,
+    media,
+    scroll::{Row, Scroll},
+    state::Tab,
+};
+use cairo::{Context, ImageSurface};
+use std::{collections::HashMap, f64::consts::TAU, fs::File};
+
+const DIR: &str = "/run/tiny-dfr/bridge";
+const CLOSE_BOX: f64 = 72.0;
+const NEW_WIDTH: f64 = 90.0;
+// one tab's place in the row, the gap between tabs, its icon and title
+const PITCH: f64 = 300.0;
+const GAP: f64 = 8.0;
+const ICON: f64 = 28.0;
+const TITLE_SIZE: f64 = 20.0;
+const PAD: f64 = 14.0;
+
+pub enum Hit {
+    Close,
+    New,
+    Strip,
+    Outside,
+}
+
+/// Parts in bar coordinates without pixel shift
+pub struct Layout {
+    pub left: f64,
+    pub close: (f64, f64),
+    pub new: (f64, f64),
+    pub strip: (f64, f64),
+    pub right: f64,
+}
+
+impl Layout {
+    /// `left`..`right`: the program's part of the row
+    pub fn new(cfg: &Config, left: f64, right: f64) -> Layout {
+        let close = (left, CLOSE_BOX);
+        let new = (close.0 + close.1 + cfg.group_spacing, NEW_WIDTH);
+        let s = new.0 + new.1 + cfg.group_spacing;
+        let strip = (s, (right - s).max(PITCH));
+        Layout { left, close, new, strip, right: strip.0 + strip.1 }
+    }
+    pub fn hit(&self, x: f64) -> Hit {
+        let within = |(l, w): (f64, f64)| x >= l - 4.0 && x < l + w + 4.0;
+        if x < self.left - 4.0 || x >= self.right + 4.0 {
+            Hit::Outside
+        } else if within(self.close) {
+            Hit::Close
+        } else if within(self.new) {
+            Hit::New
+        } else if within(self.strip) {
+            Hit::Strip
+        } else {
+            Hit::Outside
+        }
+    }
+}
+
+/// The tab of the active window's title ("<tab title> - Google Chrome"):
+/// the longest tab title it starts with
+pub fn active(tabs: &[Tab], title: &str) -> Option<usize> {
+    tabs.iter()
+        .enumerate()
+        .filter(|(_, t)| !t.title.is_empty() && title.starts_with(&t.title))
+        .max_by_key(|(_, t)| t.title.len())
+        .map(|(i, _)| i)
+}
+
+#[derive(Default)]
+pub struct Panel {
+    scroll: Scroll,
+    /// the new-tab key held
+    pub new_held: Option<u32>,
+    // tab icons by id (None: it has none), dropped when the list changes
+    icons: HashMap<String, Option<ImageSurface>>,
+    // the active tab was scrolled into view (once the list came)
+    revealed: bool,
+}
+
+impl Panel {
+    fn row(layout: &Layout, tabs: &[Tab]) -> Row {
+        Row { left: layout.strip.0, width: layout.strip.1, pitch: PITCH, count: tabs.len() }
+    }
+
+    /// The list changed: icons again; the active tab into view the first time
+    pub fn tabs_changed(&mut self, layout: &Layout, tabs: &[Tab], title: &str) {
+        self.icons.clear();
+        if !self.revealed && !tabs.is_empty() {
+            self.revealed = true;
+            if let Some(i) = active(tabs, title) {
+                self.scroll.reveal(&Self::row(layout, tabs), i);
+            }
+        }
+    }
+
+    pub fn touching(&self, slot: u32) -> bool {
+        self.scroll.touching(slot)
+    }
+
+    pub fn moving(&self) -> bool {
+        self.scroll.moving()
+    }
+
+    pub fn step(&mut self, layout: &Layout, tabs: &[Tab]) -> bool {
+        self.scroll.step(&Self::row(layout, tabs))
+    }
+
+    pub fn down(&mut self, layout: &Layout, tabs: &[Tab], slot: u32, x: f64) {
+        self.scroll.down(&Self::row(layout, tabs), slot, x);
+    }
+
+    pub fn motion(&mut self, layout: &Layout, tabs: &[Tab], slot: u32, x: f64) -> bool {
+        self.scroll.motion(&Self::row(layout, tabs), slot, x)
+    }
+
+    /// The finger went up: the tab tapped, if any
+    pub fn up(&mut self, tabs: &[Tab], slot: u32) -> Option<String> {
+        let i = self.scroll.up(slot)?;
+        tabs.get(i).map(|t| t.id.clone())
+    }
+
+    /// The PNG preview: a tab pressed
+    pub fn preview(&mut self, pressed: Option<usize>) {
+        self.scroll.pressed = pressed.map(|i| (0, i));
+    }
+
+    fn icon(&mut self, id: &str) -> Option<&ImageSurface> {
+        self.icons
+            .entry(id.to_string())
+            .or_insert_with(|| {
+                let mut f = File::open(format!("{DIR}/tab-{id}.png")).ok()?;
+                ImageSurface::create_from_png(&mut f).ok()
+            })
+            .as_ref()
+    }
+
+    /// Draw it all; the bar under it is cleared by the caller
+    pub fn draw(&mut self, c: &Context, cfg: &Config, layout: &Layout, tabs: &[Tab], title: &str, height: f64, (sx, sy): (f64, f64)) {
+        let bh = if cfg.button_height > 0.0 { cfg.button_height.min(height) } else { height * 0.7 };
+        let top = (height - bh) / 2.0 + sy;
+        let cy = height / 2.0 + sy;
+        media::close_button(c, layout.close.0 + layout.close.1 / 2.0 + sx, height);
+        // new tab: a plus
+        let (l, w) = layout.new;
+        let (r, g, b) = if self.new_held.is_some() { cfg.button_active_color } else { cfg.button_color };
+        c.set_source_rgb(r, g, b);
+        media::rounded_rect(c, l + sx, top, w, bh, cfg.button_radius);
+        c.fill().unwrap();
+        let mx = l + w / 2.0 + sx;
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        c.set_line_width(3.0);
+        c.set_line_cap(cairo::LineCap::Round);
+        c.move_to(mx - 11.0, cy);
+        c.line_to(mx + 11.0, cy);
+        c.move_to(mx, cy - 11.0);
+        c.line_to(mx, cy + 11.0);
+        c.stroke().unwrap();
+        // the tabs, cut at the row's ends
+        let (sl, sw) = layout.strip;
+        c.save().unwrap();
+        c.rectangle(sl + sx, 0.0, sw, height);
+        c.clip();
+        c.set_font_face(&cfg.font_face);
+        c.set_font_size(TITLE_SIZE);
+        if tabs.is_empty() {
+            c.set_source_rgb(0.6, 0.6, 0.6);
+            c.move_to(sl + PAD + sx, cy + 7.0);
+            let _ = c.show_text("—");
+        }
+        let current = active(tabs, title);
+        let (items, x0) = self.scroll.visible(&Self::row(layout, tabs));
+        for i in items.clone() {
+            let x = x0 + (i - items.start) as f64 * PITCH + sx;
+            let w = PITCH - GAP;
+            let pressed = self.scroll.pressed.is_some_and(|(_, p)| p == i);
+            let (r, g, b) = if pressed || current == Some(i) { cfg.button_active_color } else { cfg.button_color };
+            c.set_source_rgb(r, g, b);
+            media::rounded_rect(c, x, top, w, bh, cfg.button_radius);
+            c.fill().unwrap();
+            let mut text_left = x + PAD;
+            let id = tabs[i].id.clone();
+            if let Some(icon) = self.icon(&id) {
+                let scale = ICON / icon.width().max(icon.height()).max(1) as f64;
+                c.save().unwrap();
+                c.translate(x + PAD, (cy - ICON / 2.0).round());
+                c.scale(scale, scale);
+                c.set_source_surface(icon, 0.0, 0.0).unwrap();
+                c.source().set_filter(cairo::Filter::Good);
+                c.paint().unwrap();
+                c.restore().unwrap();
+                text_left += ICON + 10.0;
+            } else {
+                // no icon: a dot in its place
+                c.set_source_rgb(0.55, 0.55, 0.55);
+                c.arc(x + PAD + ICON / 2.0, cy, 5.0, 0.0, TAU);
+                c.fill().unwrap();
+                text_left += ICON + 10.0;
+            }
+            c.set_source_rgb(1.0, 1.0, 1.0);
+            let t = media::fit(c, &tabs[i].title, x + w - PAD - text_left);
+            c.move_to(text_left, cy + 7.0);
+            let _ = c.show_text(&t);
+        }
+        c.restore().unwrap();
+    }
+}
