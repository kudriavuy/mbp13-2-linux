diff --git a/src/scroll.rs b/src/scroll.rs
new file mode 100644
index 0000000..7682878
--- /dev/null
+++ b/src/scroll.rs
@@ -0,0 +1,145 @@
+// A row of equal items that scrolls with the finger and runs on after a
+// flick (the emoji and tab panels). Positions are bar coordinates without
+// pixel shift; the row starts at `left`, is `width` wide, its items `pitch`.
+use std::time::{Duration, Instant};
+
+// a flick: speed it keeps (px/s), how fast it fades, when it stops
+const FLING_MIN: f64 = 150.0;
+const FLING_TAU: f64 = 0.45;
+const FLING_STOP: f64 = 15.0;
+// the finger's speed: from its moves in the last this long
+const VELOCITY_WINDOW: Duration = Duration::from_millis(80);
+
+#[derive(Clone, Copy)]
+pub struct Row {
+    pub left: f64,
+    pub width: f64,
+    pub pitch: f64,
+    pub count: usize,
+}
+
+impl Row {
+    fn max_offset(&self) -> f64 {
+        (self.count as f64 * self.pitch - self.width).max(0.0)
+    }
+}
+
+/// A finger on the row
+struct Touch {
+    slot: u32,
+    x0: f64,
+    offset0: f64,
+    dragging: bool,
+    // recent (time, x) for the speed at release
+    trail: Vec<(Instant, f64)>,
+}
+
+#[derive(Default)]
+pub struct Scroll {
+    /// how far the row is scrolled (px from the first item)
+    pub offset: f64,
+    touch: Option<Touch>,
+    /// the item under a finger that has not slid
+    pub pressed: Option<(u32, usize)>,
+    /// running on after a flick: speed in px/s (positive: towards the end)
+    fling: Option<(f64, Instant)>,
+}
+
+impl Scroll {
+    /// The item at `x`, if any
+    pub fn item_at(&self, row: &Row, x: f64) -> Option<usize> {
+        let i = ((x - row.left + self.offset) / row.pitch).floor();
+        (i >= 0.0 && (i as usize) < row.count).then_some(i as usize)
+    }
+
+    /// The items to draw and the x of the first one's left edge
+    pub fn visible(&self, row: &Row) -> (std::ops::Range<usize>, f64) {
+        let first = (self.offset / row.pitch).floor().max(0.0) as usize;
+        let last = (((self.offset + row.width) / row.pitch).ceil() as usize).min(row.count);
+        (first..last, row.left + first as f64 * row.pitch - self.offset)
+    }
+
+    /// Scroll to item `i` at the left end (as far as the row goes)
+    pub fn show_from(&mut self, row: &Row, i: usize) {
+        self.offset = (i as f64 * row.pitch).min(row.max_offset());
+    }
+
+    /// Scroll as little as needed for item `i` to be seen whole
+    pub fn reveal(&mut self, row: &Row, i: usize) {
+        let x = i as f64 * row.pitch;
+        if x < self.offset {
+            self.offset = x;
+        } else if x + row.pitch > self.offset + row.width {
+            self.offset = (x + row.pitch - row.width).min(row.max_offset());
+        }
+        self.offset = self.offset.clamp(0.0, row.max_offset());
+    }
+
+    /// Whether this finger scrolls or holds the row
+    pub fn touching(&self, slot: u32) -> bool {
+        self.touch.as_ref().is_some_and(|t| t.slot == slot)
+    }
+
+    pub fn moving(&self) -> bool {
+        self.fling.is_some()
+    }
+
+    /// One step of a flick; false when it has stopped
+    pub fn step(&mut self, row: &Row) -> bool {
+        let Some((v, at)) = self.fling else { return false };
+        let dt = at.elapsed().as_secs_f64();
+        let v1 = v * (-dt / FLING_TAU).exp();
+        // the distance run over dt with the speed fading exponentially
+        self.offset += v * FLING_TAU * (1.0 - (-dt / FLING_TAU).exp());
+        let max = row.max_offset();
+        let stopped = v1.abs() < FLING_STOP || self.offset <= 0.0 || self.offset >= max;
+        self.offset = self.offset.clamp(0.0, max);
+        self.fling = (!stopped).then_some((v1, Instant::now()));
+        true
+    }
+
+    pub fn down(&mut self, row: &Row, slot: u32, x: f64) {
+        // a touch stops a flick (and is then not a tap)
+        let was_moving = self.fling.take().is_some();
+        self.touch = Some(Touch { slot, x0: x, offset0: self.offset, dragging: was_moving, trail: vec![(Instant::now(), x)] });
+        self.pressed = if was_moving { None } else { self.item_at(row, x).map(|i| (slot, i)) };
+    }
+
+    /// true when it is this row's finger
+    pub fn motion(&mut self, row: &Row, slot: u32, x: f64) -> bool {
+        let max = row.max_offset();
+        let Some(t) = self.touch.as_mut().filter(|t| t.slot == slot) else { return false };
+        if !t.dragging && (x - t.x0).abs() > crate::slider::DRAG_THRESHOLD_PX {
+            t.dragging = true;
+            // the row follows the finger from where it is now, without a jump
+            t.x0 = x;
+            self.pressed = None;
+        }
+        if t.dragging {
+            self.offset = (t.offset0 - (x - t.x0)).clamp(0.0, max);
+        }
+        let now = Instant::now();
+        t.trail.push((now, x));
+        t.trail.retain(|&(at, _)| now.duration_since(at) <= VELOCITY_WINDOW);
+        true
+    }
+
+    /// The finger went up: the item tapped, if any
+    pub fn up(&mut self, slot: u32) -> Option<usize> {
+        let t = self.touch.take().filter(|t| t.slot == slot)?;
+        if t.dragging {
+            if let (Some(&(t0, x0)), Some(&(t1, x1))) = (t.trail.first(), t.trail.last()) {
+                let dt = t1.duration_since(t0).as_secs_f64();
+                // recent moves only: a finger that stopped before lifting does not fling
+                if dt > 0.005 && t1.elapsed() < VELOCITY_WINDOW {
+                    let v = -(x1 - x0) / dt;
+                    if v.abs() > FLING_MIN {
+                        self.fling = Some((v, Instant::now()));
+                    }
+                }
+            }
+            return None;
+        }
+        self.pressed.take().filter(|(s, _)| *s == slot).map(|(_, i)| i)
+    }
+}
