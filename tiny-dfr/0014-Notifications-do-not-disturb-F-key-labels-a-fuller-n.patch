diff --git a/src/notice.rs b/src/notice.rs
new file mode 100644
index 0000000..a367c29
--- /dev/null
+++ b/src/notice.rs
@@ -0,0 +1,67 @@
+// A notification on the bar (Notifications = true): the helper reports each
+// new one (/run/tiny-dfr/bridge/notification: when, the program, the title;
+// none while do not disturb is on), and for NotificationSeconds a capsule
+// over the program's part of the row shows the icon, the program and the
+// title. A tap on it takes it away; the Control Strip stays usable.
+use crate::{config::Config, state::Notice, Button};
+use cairo::Context;
+
+const ICON_BOX: f64 = 56.0;
+const PAD: f64 = 18.0;
+
+/// `left`..`right`: the program's part of the row (cleared here)
+pub fn draw(c: &Context, cfg: &Config, (left, right): (f64, f64), height: f64, (sx, sy): (f64, f64), notice: &Notice, icon: Option<&Button>) {
+    let bh = if cfg.button_height > 0.0 { cfg.button_height.min(height) } else { height * 0.7 };
+    let top = (height - bh) / 2.0;
+    c.set_source_rgb(0.0, 0.0, 0.0);
+    c.rectangle(left + sx - cfg.group_spacing / 2.0, 0.0, right - left + cfg.group_spacing, height);
+    c.fill().unwrap();
+    let (r, g, b) = cfg.button_color;
+    c.set_source_rgb(r, g, b);
+    let rad = cfg.button_radius.min(bh / 2.0);
+    let w = right - left;
+    c.new_sub_path();
+    c.arc(left + w - rad + sx, top + rad, rad, (-90.0f64).to_radians(), 0.0);
+    c.arc(left + w - rad + sx, top + bh - rad, rad, 0.0, (90.0f64).to_radians());
+    c.arc(left + rad + sx, top + bh - rad, rad, (90.0f64).to_radians(), (180.0f64).to_radians());
+    c.arc(left + rad + sx, top + rad, rad, (180.0f64).to_radians(), (270.0f64).to_radians());
+    c.close_path();
+    c.fill().unwrap();
+    let mut x = left + PAD;
+    if let Some(icon) = icon {
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        icon.render(c, height as i32, x + sx, ICON_BOX as u64, sy);
+        x += ICON_BOX + 8.0;
+    }
+    c.set_font_face(&cfg.font_face);
+    c.set_font_size(cfg.font_size * 0.85);
+    let room = right - PAD - x;
+    let base = (height / 2.0 + 9.0).round() + sy;
+    let app = fit(c, &notice.app, room * 0.4);
+    c.set_source_rgb(0.65, 0.65, 0.67);
+    c.move_to(x + sx, base);
+    let _ = c.show_text(&app);
+    let used = c.text_extents(&app).map_or(0.0, |e| e.x_advance());
+    if !notice.summary.is_empty() {
+        let sep = if app.is_empty() { "" } else { "   " };
+        let summary = fit(c, &format!("{sep}{}", notice.summary), room - used);
+        c.set_source_rgb(1.0, 1.0, 1.0);
+        let _ = c.show_text(&summary);
+    }
+}
+
+/// `text` cut to fit `width` at the current font size, with an ellipsis
+fn fit(c: &Context, text: &str, width: f64) -> String {
+    if c.text_extents(text).map_or(0.0, |e| e.x_advance()) <= width {
+        return text.to_string();
+    }
+    let mut chars: Vec<char> = text.chars().collect();
+    while !chars.is_empty() {
+        chars.pop();
+        let t = chars.iter().collect::<String>().trim_end().to_string() + "…";
+        if c.text_extents(&t).map_or(0.0, |e| e.x_advance()) <= width {
+            return t;
+        }
+    }
+    String::new()
+}
