+/// The notification to show now, if any (fresh, not tapped away, not while
+/// do not disturb is on)
+fn notice_now<'a>(cfg: &Config, session: &'a state::State, dismissed: i64) -> Option<&'a state::Notice> {
+    let n = session.notice.as_ref()?;
+    let now_ms = SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |d| d.as_millis() as i64);
+    (cfg.notifications
+        && n.at_ms != dismissed
+        && now_ms - n.at_ms < cfg.notification_time.as_millis() as i64
+        && now_ms >= n.at_ms - 1000
+        && session.dnd != Some(true))
+    .then_some(n)
+}
+
+/// An icon of the config by name (48 px), as a key's image
+fn named_icon(name: Option<&String>) -> Option<Button> {
+    try_load_image(name?, None::<&str>, 48, 48).ok().map(|image| {
+        let mut b = Button::new_spacer();
+        b.image = image;
+        b.icon_width = 48.0;
+        b.icon_height = 48.0;
+        b
+    })
+}
