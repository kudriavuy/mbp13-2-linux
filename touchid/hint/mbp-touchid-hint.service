# Touch ID hint for the Touch Bar: watches fprintd (system bus monitor, root
# only) and writes /run/tiny-dfr/touchid for tiny-dfr. Reads message names and
# the verification result; writes only that file.
[Unit]
Description=Touch Bar: Touch ID hint (watches fprintd)
After=dbus.service systemd-tmpfiles-setup.service

[Service]
ExecStart=/usr/local/bin/mbp-touchid-hint
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/run/tiny-dfr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
